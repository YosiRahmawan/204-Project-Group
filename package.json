{
  "name": "204-project-group",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.20.0 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @204/web --filter @204/server dev",
    "build": "corepack pnpm -r --if-present build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
