# Local development. Copy this file to .env (it is ignored by git).
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
LOG_LEVEL=info

# Leo's login. Required, at least 12 characters, never commit the real value.
OWNER_PASSWORD=

# Where tasks and uploaded files are stored (relative to apps/server by default).
# DATABASE_PATH=data/204.db
# UPLOAD_DIR=data/uploads
# SESSION_HOURS=12

# Provider API keys for later phases. Only the server reads these; they never reach the browser,
# the database or the logs. Leave empty until AI execution exists.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Model list the agent form may offer (default: apps/server/models.registry.json).
# MODEL_REGISTRY_PATH=

# Existing Obsidian vault used as shared memory (must already contain a .obsidian folder).
# Leave empty to keep memory off. Never put keys or passwords in the vault.
# OBSIDIAN_VAULT_PATH=E:/204 Project Memory/STARTUP-BRAIN

# Hermes API server for Akira (loopback only). Start it with: hermes -p akira gateway run
# HERMES_API_URL=http://127.0.0.1:8643
# HERMES_API_KEY=
